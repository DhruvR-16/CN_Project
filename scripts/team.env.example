# Copy this to scripts/team.env on every Mac and update it after checking the
# current DHCP addresses. These role addresses were reported on 2026-11-23;
# recheck them before a later demo because DHCP can change.
TEAM_DOMAIN="team1.test"
APP_HOST="app.team1.test"
API_HOST="api.team1.test"

DNS_PRIMARY_IP="10.7.13.217"
DNS_BACKUP_IP="10.7.30.216" # Dhruv; also hosts Backend A on a different port.
EDGE_PRIMARY_IP="10.7.26.222"
EDGE_STANDBY_IP="10.7.15.193" # Lakshya; standby edge is not yet verified.
BACKEND_A_IP="10.7.30.216"
BACKEND_B_IP="10.7.15.193"

BACKEND_A_PORT="3001"
BACKEND_B_PORT="3002"
EDGE_PORT="8443" # Repo nginx config uses 8443; use 443 if your active config does.
NETWORK_INTERFACE="en0"
NETWORK_SERVICE="Wi-Fi" # Set this to the exact name shown by networksetup -listallnetworkservices.
DNS_TTL="30"
TLS_CA_FILE="" # Blank uses tls/server.crt in this repository.
